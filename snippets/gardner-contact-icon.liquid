{%- case icon -%}
  {%- when 'headset' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 13v-1a8 8 0 0 1 16 0v1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      <rect x="3" y="12" width="4" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7"/>
      <rect x="17" y="12" width="4" height="7" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7"/>
      <path d="M20 19a4 4 0 0 1-4 3h-2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  {%- when 'question' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.7"/>
      <path d="M9.5 9.4a2.6 2.6 0 1 1 3.9 2.3c-.9.5-1.4 1.1-1.4 2.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      <path d="M12 17h.01" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
    </svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M3 6.5h10v10H3zM13 9.5h4l3.5 3.5V16H13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <circle cx="7" cy="18.5" r="2" fill="none" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="17.5" cy="18.5" r="2" fill="none" stroke="currentColor" stroke-width="1.7"/>
    </svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20 4C11.7 4 5 7.8 5 14.6c0 2.6 1.6 4.7 4.2 5.4C10 13.8 14 9.7 19 8c-4.3 2.6-7.2 6.3-8.4 11.4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M20 4c0 8.8-3.7 13.9-10.8 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
  {%- when 'box' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m4 7.2 8-4.2 8 4.2v9.6L12 21l-8-4.2V7.2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="m4 7.2 8 4.3 8-4.3M12 11.5V21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
    </svg>
  {%- when 'mail' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="3" y="5.5" width="18" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7"/>
      <path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'phone' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M7.1 3.5 9.6 8 7.8 9.8c1.2 2.4 3.1 4.3 5.5 5.5l1.8-1.8 4.4 2.5-.7 3.1c-.2 1-1.1 1.6-2.1 1.5C10.1 19.9 4.1 13.9 3.4 7.3c-.1-1 .5-1.9 1.5-2.1l2.2-.7Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'pin' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20 10.2c0 5.4-8 11.3-8 11.3s-8-5.9-8-11.3a8 8 0 1 1 16 0Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <circle cx="12" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1.7"/>
    </svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20.4 5.6a5 5 0 0 0-7.1 0L12 6.9l-1.3-1.3a5 5 0 0 0-7.1 7.1L12 21l8.4-8.3a5 5 0 0 0 0-7.1Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
    </svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3 20 6v5.5c0 4.4-3.3 7.9-8 9.5-4.7-1.6-8-5.1-8-9.5V6l8-3Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="m8.5 11.8 2.4 2.4 4.7-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.8 8.8 0 0 1-3.2-.8L4 20l1.7-4.3A7.1 7.1 0 0 1 4.5 12a7.5 7.5 0 0 1 8-7.5 7.4 7.4 0 0 1 7.5 7Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
      <path d="M8.5 12h.01M12 12h.01M15.5 12h.01" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
