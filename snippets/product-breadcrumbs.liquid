{%- liquid
  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank
    assign breadcrumb_collection = product.collections.first
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ request.origin | append: routes.root_url | json }}
      },
      {%- if breadcrumb_collection != blank -%}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ breadcrumb_collection.title | json }},
        "item": {{ request.origin | append: breadcrumb_collection.url | json }}
      },
      {%- endif -%}
      {
        "@type": "ListItem",
        "position": {% if breadcrumb_collection != blank %}3{% else %}2{% endif %},
        "name": {{ product.title | json }},
        "item": {{ request.origin | append: product.url | json }}
      }
    ]
  }
</script>
