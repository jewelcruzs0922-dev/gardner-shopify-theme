<section class="g-wishlist color-{{ section.settings.color_scheme }} gradient">
  <div class="g-container">
    <header class="g-wishlist__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="g-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="g-wishlist__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="g-wishlist__intro rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    <p class="g-wishlist__note" data-wishlist-note>
      Saved in this browser only. Wishlists are not synced across devices or customer accounts.
    </p>

    <p class="g-wishlist__status" data-wishlist-status role="status">Loading your saved tools&hellip;</p>
    <div class="g-wishlist-grid" data-wishlist-grid aria-busy="true"></div>

    <div class="g-wishlist-empty" data-wishlist-empty hidden>
      <h2 class="g-wishlist-empty__title">Your wishlist is empty</h2>
      <p class="g-wishlist-empty__text">Tap the heart on any tool to keep it here for later.</p>
      <a class="button" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">
        Shop all tools
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wishlist",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your selection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wishlist"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Tools you have saved while browsing Gardner.</p>"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop link"
    }
  ],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
