{% javascript %}
  (() => {
    if (customElements.get('gardner-contact-faq')) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    class GardnerContactFaq extends HTMLElement {
      connectedCallback() {
        if (this.dataset.ready === 'true') return;
        this.dataset.ready = 'true';

        this.addEventListener('click', (event) => {
          const summary = event.target.closest('summary');
          if (!summary || !this.contains(summary)) return;

          const item = summary.parentElement;
          if (!item || item.tagName !== 'DETAILS' || !item.open) return;
          if (item.classList.contains('is-closing')) {
            event.preventDefault();
            return;
          }
          if (reducedMotion.matches) return;

          event.preventDefault();
          item.classList.add('is-closing');

          window.setTimeout(() => {
            item.open = false;
            item.classList.remove('is-closing');
          }, 320);
        });
      }
    }

    customElements.define('gardner-contact-faq', GardnerContactFaq);
  })();
{% endjavascript %}

