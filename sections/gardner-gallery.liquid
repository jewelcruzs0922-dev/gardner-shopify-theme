{%- liquid
  assign show_header = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank
    assign show_header = true
  endif

  assign row_one = section.blocks | slice: 0, 6
  assign row_two = section.blocks | slice: 6, 6
-%}

<section class="g-gallery" aria-label="Garden gallery">
  <div class="g-gallery__inner">
    {%- if show_header -%}
      <div class="g-gallery__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="g-eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="g-gallery__title">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}
          <div class="g-gallery__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="g-gallery__viewport">
      <div class="g-gallery__rows">
        <div class="g-gallery__track g-gallery__track--one">
          {% render 'gardner-gallery-row', row_blocks: row_one, row_start: 0, clone_first: false %}
        </div>

        {%- if row_two.size > 0 -%}
          <div class="g-gallery__track g-gallery__track--two">
            {% render 'gardner-gallery-row', row_blocks: row_two, row_start: 6, clone_first: true %}
          </div>
        {%- endif -%}
      </div>
    </div>

    <dialog class="g-gallery-lightbox" data-gallery-dialog aria-label="Gallery image viewer">
      <div class="g-gallery-lightbox__stage" data-gallery-stage>
        <button class="g-gallery-lightbox__close" type="button" data-gallery-close aria-label="Close image viewer">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>

        <button class="g-gallery-lightbox__arrow g-gallery-lightbox__arrow--prev" type="button" data-gallery-prev aria-label="Previous image">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="g-gallery-lightbox__slides">
          {%- for block in section.blocks -%}
            {%- assign fallback_index = forloop.index | prepend: '00' | slice: -2, 2 -%}
            {%- capture fallback_name -%}gardner-gallery-full-{{ fallback_index }}.jpg{%- endcapture -%}
            {%- assign alt_text = block.settings.alt | default: block.settings.image.alt | default: 'Garden tools and plants' -%}

            <figure class="g-gallery-lightbox__slide" data-gallery-slide="{{ forloop.index0 }}" hidden>
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 2000
                  | image_tag:
                    class: 'g-gallery-lightbox__img',
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 90vw, 100vw',
                    widths: '800, 1200, 1600, 2000',
                    alt: alt_text
                }}
              {%- else -%}
                <img
                  class="g-gallery-lightbox__img"
                  src="{{ fallback_name | asset_url }}"
                  alt="{{ alt_text | escape }}"
                  width="1600"
                  height="1200"
                  loading="lazy"
                >
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>

        <button class="g-gallery-lightbox__arrow g-gallery-lightbox__arrow--next" type="button" data-gallery-next aria-label="Next image">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <p class="g-gallery-lightbox__counter" data-gallery-counter aria-live="polite">1 / {{ section.blocks.size }}</p>
      </div>
    </dialog>
  {%- endif -%}

  {%- if section.settings.note != blank -%}
    <div class="g-gallery__inner">
      <p class="g-gallery__note">{{ section.settings.note }}</p>
    </div>
  {%- endif -%}

  <script src="{{ 'gardner-gallery.js' | asset_url }}" defer></script>
</section>

{% schema %}
{
  "name": "Gardner gallery",
  "tag": "section",
  "class": "section-gardner-gallery",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "note", "label": "Note" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty to use the built-in demo image."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gardner gallery"
    }
  ]
}
{% endschema %}
