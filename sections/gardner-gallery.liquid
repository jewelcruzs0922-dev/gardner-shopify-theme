{%- liquid
  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2
  assign image_3 = section.settings.image_3
-%}
<section class="g-gallery">
  <div class="page-width">
    <div class="g-gallery__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="g-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="g-gallery__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <div class="g-gallery__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="g-gallery__grid">
      <figure class="g-gallery__item g-gallery__item--tall">
        {%- if image_1 != blank -%}
          {{ image_1 | image_url: width: 1200 | image_tag: class: 'g-gallery__img', loading: 'lazy', sizes: '(min-width: 990px) 40vw, 100vw', widths: '500, 800, 1200', alt: section.settings.alt_1 }}
        {%- else -%}
          <img class="g-gallery__img" src="{{ 'gardner-hero-1200.jpg' | asset_url }}" srcset="{{ 'gardner-hero-800.jpg' | asset_url }} 800w, {{ 'gardner-hero-1200.jpg' | asset_url }} 1200w, {{ 'gardner-hero.jpg' | asset_url }} 2400w" sizes="(min-width: 990px) 40vw, 100vw" alt="{{ section.settings.alt_1 | escape }}" width="2400" height="1340" loading="lazy">
        {%- endif -%}
      </figure>
      <figure class="g-gallery__item">
        {%- if image_2 != blank -%}
          {{ image_2 | image_url: width: 1000 | image_tag: class: 'g-gallery__img', loading: 'lazy', sizes: '(min-width: 990px) 30vw, 100vw', widths: '400, 700, 1000', alt: section.settings.alt_2 }}
        {%- else -%}
          <img class="g-gallery__img" src="{{ 'gardner-story-900.jpg' | asset_url }}" srcset="{{ 'gardner-story-600.jpg' | asset_url }} 600w, {{ 'gardner-story-900.jpg' | asset_url }} 900w, {{ 'gardner-story-1200.jpg' | asset_url }} 1200w" sizes="(min-width: 990px) 30vw, 100vw" alt="{{ section.settings.alt_2 | escape }}" width="1200" height="1490" loading="lazy">
        {%- endif -%}
      </figure>
      <figure class="g-gallery__item">
        {%- if image_3 != blank -%}
          {{ image_3 | image_url: width: 1000 | image_tag: class: 'g-gallery__img', loading: 'lazy', sizes: '(min-width: 990px) 30vw, 100vw', widths: '400, 700, 1000', alt: section.settings.alt_3 }}
        {%- else -%}
          <img class="g-gallery__img" src="{{ 'gardner-footer-1200.jpg' | asset_url }}" srcset="{{ 'gardner-footer-800.jpg' | asset_url }} 800w, {{ 'gardner-footer-1200.jpg' | asset_url }} 1200w, {{ 'gardner-footer-1600.jpg' | asset_url }} 1600w" sizes="(min-width: 990px) 30vw, 100vw" alt="{{ section.settings.alt_3 | escape }}" width="1600" height="893" loading="lazy">
        {%- endif -%}
      </figure>
    </div>

    {%- if section.settings.note != blank -%}
      <p class="g-gallery__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gardner gallery",
  "tag": "section",
  "class": "section-gardner-gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the garden" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A closer look" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Original editorial imagery made for this demo storefront.</p>"
    },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "text", "id": "alt_1", "label": "Image 1 alt text", "default": "Raised garden beds in warm evening light" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "text", "id": "alt_2", "label": "Image 2 alt text", "default": "Hands planting a seedling in a raised bed" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "text", "id": "alt_3", "label": "Image 3 alt text", "default": "Garden hand tools on a potting bench" },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Editorial imagery for this portfolio demo — not customer posts or a live social feed."
    }
  ],
  "presets": [{ "name": "Gardner gallery" }]
}
{% endschema %}
