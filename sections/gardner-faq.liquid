{%- liquid
  assign heading_id = 'GardnerFaqTitle-' | append: section.id | append: '-title'
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}

{%- if section.settings.show_section -%}
  <section
    class="g-faq g-faq--{{ section.id }}{% if section.settings.image_position == 'right' %} g-faq--image-right{% endif %}"
    {% if section.settings.heading != blank %}
      aria-labelledby="{{ heading_id }}"
    {% endif %}
  >
    <div class="g-faq__inner">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <header class="g-faq__head">
          {%- if section.settings.eyebrow != blank -%}
            <p class="g-faq__eyebrow">
              <span class="g-faq__eyebrow-line" aria-hidden="true"></span>
              {{ section.settings.eyebrow | escape }}
            </p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="g-faq__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="g-faq__layout">
        <figure class="g-faq__media">
          {%- if has_image -%}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                decoding: 'async',
                sizes: '(min-width: 992px) 45vw, 100vw',
                widths: '600, 900, 1200, 1600',
                alt: section.settings.image_alt
            }}
          {%- else -%}
            <img
              src="{{ 'gardner-faq.jpg' | asset_url }}"
              srcset="{{ 'gardner-faq-600.jpg' | asset_url }} 600w, {{ 'gardner-faq-900.jpg' | asset_url }} 900w, {{ 'gardner-faq-1200.jpg' | asset_url }} 1200w, {{ 'gardner-faq.jpg' | asset_url }} 1600w"
              sizes="(min-width: 992px) 45vw, 100vw"
              alt="{{ section.settings.image_alt | escape }}"
              width="1600"
              height="1745"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </figure>

        <gardner-faq-list class="g-faq__list">
          {%- for block in section.blocks -%}
            <details
              class="g-faq__item"
              {% if section.settings.open_first and forloop.first %}
                open
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="g-faq__summary">
                <span class="g-faq__question-wrap">
                  <span class="g-faq__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <h3 class="g-faq__question">{{ block.settings.question | escape }}</h3>
                </span>
                <span class="g-faq__icon" aria-hidden="true"></span>
              </summary>
              <div class="g-faq__answer">
                <div class="g-faq__answer-inner">
                  <div class="g-faq__answer-content rte">{{ block.settings.answer }}</div>
                </div>
              </div>
            </details>
          {%- endfor -%}
        </gardner-faq-list>
      </div>
    </div>
  </section>
{%- endif -%}

{% style %}
  .g-faq--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .g-faq--{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
  }
{% endstyle %}

{% stylesheet %}
  .g-faq {
    background: var(--g-cream);
    color: var(--g-ink);
  }

  .g-faq__inner {
    box-sizing: content-box;
    width: auto;
    max-width: 129.6rem;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .g-faq__head {
    margin: 0 0 6rem;
  }

  .g-faq__eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 0.4rem;
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--g-ink-soft);
  }

  .g-faq__eyebrow-line {
    display: block;
    width: 1px;
    height: 1.2rem;
    background: var(--g-apple);
  }

  .g-faq__heading {
    max-width: 16ch;
    margin: 0;
    border: 0;
    font-family: var(--font-heading-family);
    font-size: 5.8rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--g-ink);
  }

  .g-faq__layout {
    display: flex;
    align-items: center;
    gap: 6rem;
  }

  .g-faq--image-right .g-faq__layout {
    flex-direction: row-reverse;
  }

  .g-faq__media {
    position: relative;
    flex: 0 0 45%;
    aspect-ratio: 11 / 12;
    margin: 0;
    overflow: hidden;
    border-radius: var(--g-radius-md);
    background: var(--g-sage);
  }

  .g-faq__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .g-faq__list {
    display: block;
    flex: 1;
    min-width: 0;
  }

  .g-faq__item {
    margin: 0;
    border-bottom: 1px solid rgba(30, 42, 22, 0.16);
  }

  .g-faq__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.4rem;
    box-sizing: border-box;
    min-height: 6.5rem;
    padding: 2rem 0;
    cursor: pointer;
    list-style: none;
  }

  .g-faq__summary::-webkit-details-marker {
    display: none;
  }

  .g-faq__summary:focus-visible {
    outline: 2px solid var(--g-apple);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .g-faq__question-wrap {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 2rem;
    min-width: 0;
  }

  .g-faq__number {
    flex: 0 0 auto;
    font-family: var(--font-body-family);
    font-size: 1.8rem;
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    line-height: 1.333;
    color: var(--g-ink);
  }

  .g-faq__question {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.8rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.333;
    color: var(--g-ink);
  }

  .g-faq__icon {
    position: relative;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    color: var(--g-ink);
  }

  .g-faq__icon::before,
  .g-faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    background: currentColor;
    transition: transform var(--g-duration) var(--g-ease), opacity var(--g-duration) var(--g-ease);
  }

  .g-faq__icon::before {
    width: 1.3rem;
    height: 1px;
    transform: translate(-50%, -50%);
  }

  .g-faq__icon::after {
    width: 1px;
    height: 1.3rem;
    transform: translate(-50%, -50%);
  }

  .g-faq__item[open] .g-faq__icon::after {
    transform: translate(-50%, -50%) scaleY(0);
  }

  .g-faq__item[open] .g-faq__icon {
    color: var(--g-apple);
  }

  .g-faq__item.is-closing .g-faq__icon {
    color: var(--g-ink);
  }

  .g-faq__item.is-closing .g-faq__icon::after {
    transform: translate(-50%, -50%) scaleY(1);
  }

  .g-faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms var(--g-ease);
  }

  .g-faq__item[open] .g-faq__answer {
    grid-template-rows: 1fr;
  }

  .g-faq__item.is-closing .g-faq__answer {
    grid-template-rows: 0fr;
  }

  .g-faq__answer-inner {
    min-height: 0;
    overflow: hidden;
  }

  .g-faq__answer-content {
    padding: 0 0 2.2rem 3.6rem;
    font-size: 1.6rem;
    line-height: 1.7;
    color: var(--g-ink-soft);
  }

  .g-faq__answer-content p {
    margin: 0;
  }

  .g-faq__answer-content p + p {
    margin-top: 1em;
  }

  .g-faq__answer-content a {
    color: var(--g-ink);
    text-decoration: underline;
    text-decoration-color: var(--g-apple);
    text-underline-offset: 0.2em;
  }

  @media screen and (max-width: 991px) {
    .g-faq__head {
      margin-bottom: 5rem;
    }

    .g-faq__heading {
      font-size: 5.2rem;
    }

    .g-faq__layout,
    .g-faq--image-right .g-faq__layout {
      flex-direction: column;
      align-items: stretch;
      gap: 4rem;
    }

    .g-faq__media {
      flex: none;
      width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .g-faq__head {
      margin-bottom: 4rem;
    }

    .g-faq__heading {
      font-size: 3.4rem;
    }

    .g-faq__layout,
    .g-faq--image-right .g-faq__layout {
      gap: 3rem;
    }

    .g-faq__summary {
      min-height: 6.4rem;
      padding: 0.8rem 0;
    }

    .g-faq__question-wrap {
      gap: 2rem;
    }

    .g-faq__number,
    .g-faq__question {
      font-size: 1.6rem;
      line-height: 1.5;
    }

    .g-faq__icon {
      width: 3rem;
      height: 3rem;
    }

    .g-faq__icon::before {
      width: 1.4rem;
    }

    .g-faq__icon::after {
      height: 1.4rem;
    }

    .g-faq__answer-content {
      padding: 0 0 1.5rem 2rem;
      font-size: 1.4rem;
      line-height: 1.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .g-faq__answer,
    .g-faq__icon::before,
    .g-faq__icon::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    if (customElements.get('gardner-faq-list')) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    class GardnerFaqList extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;

        this.addEventListener('click', (event) => {
          const summary = event.target.closest('summary');
          if (!summary || !this.contains(summary)) return;

          const item = summary.parentElement;
          if (!item || item.tagName !== 'DETAILS' || !item.open) return;

          if (item.classList.contains('is-closing')) {
            event.preventDefault();
            return;
          }

          if (reducedMotion.matches) return;

          event.preventDefault();
          item.classList.add('is-closing');

          window.setTimeout(() => {
            item.open = false;
            item.classList.remove('is-closing');
          }, 340);
        });
      }
    }

    customElements.define('gardner-faq-list', GardnerFaqList);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Gardner FAQ",
  "tag": "section",
  "class": "section-gardner-faq",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show section", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ's" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Have Any Questions?" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Supporting image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Gardener tending potted shrubs in a greenhouse"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question by default",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What types of gardening tools and equipment do you sell?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Gardner carries hand tools, pruning and cutting tools, digging and planting tools, watering equipment, garden accessories, and selected power tools.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Gardner FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What types of gardening tools and equipment do you sell?",
