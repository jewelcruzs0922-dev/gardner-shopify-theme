{%- liquid
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
-%}
<section
  class="g-hero{% if section.settings.height == 'medium' %} g-hero--medium{% endif %}{% if section.settings.alignment == 'center' %} g-hero--center{% endif %}"
  style="--g-hero-overlay: {{ overlay }};"
>
  <div class="g-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'g-hero__img',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1100, 1500, 1780, 2000, 2400',
          alt: ''
      }}
    {%- else -%}
      <img
        class="g-hero__img"
        src="{{ 'gardner-hero-1800.jpg' | asset_url }}"
        srcset="{{ 'gardner-hero-800.jpg' | asset_url }} 800w, {{ 'gardner-hero-1200.jpg' | asset_url }} 1200w, {{ 'gardner-hero-1800.jpg' | asset_url }} 1800w, {{ 'gardner-hero.jpg' | asset_url }} 2400w"
        sizes="100vw"
        alt=""
        width="2400"
        height="1340"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="g-hero__content page-width">
    <div class="g-hero__logo" aria-hidden="true">
      <svg viewBox="0 0 32 32" focusable="false">
        <path d="M16 29V15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        <path d="M16 18C9 18 5 13.5 4.5 6.5 11.5 6 16 10.5 16 18Z" fill="currentColor"/>
        <path d="M16 14C22.5 14 27 10 27.5 3.5 20.5 3 16 7.5 16 14Z" fill="currentColor"/>
      </svg>
    </div>
    {%- if section.settings.eyebrow != blank -%}
      <p class="g-eyebrow g-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="g-hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="g-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="g-hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a class="button button--secondary" href="{{ section.settings.button_link_2 | default: '/blogs/news' }}">
          {{- section.settings.button_label_2 -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gardner hero",
  "tag": "section",
  "class": "section-gardner-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tools for everyday gardeners." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop garden tools" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Read the guides" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 40
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    }
  ],
  "presets": [{ "name": "Gardner hero" }]
}
{% endschema %}
