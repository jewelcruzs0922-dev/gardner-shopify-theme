<section class="g-trust">
  <div class="page-width g-trust__grid">
    <div class="g-trust__item">
      <span class="g-trust__icon" aria-hidden="true">
        {{- 'icon-lock.svg' | inline_asset_content -}}
      </span>
      <div>
        <h2 class="g-trust__title">{{ section.settings.title_1 }}</h2>
        <p class="g-trust__text">{{ section.settings.text_1 }}</p>
      </div>
    </div>
    <div class="g-trust__item">
      <span class="g-trust__icon" aria-hidden="true">
        {{- 'icon-leaf.svg' | inline_asset_content -}}
      </span>
      <div>
        <h2 class="g-trust__title">{{ section.settings.title_2 }}</h2>
        <p class="g-trust__text">{{ section.settings.text_2 }}</p>
      </div>
    </div>
    <div class="g-trust__item">
      <span class="g-trust__icon" aria-hidden="true">
        {{- 'icon-chat-bubble.svg' | inline_asset_content -}}
      </span>
      <div>
        <h2 class="g-trust__title">{{ section.settings.title_3 }}</h2>
        <p class="g-trust__text">
          {{ section.settings.text_3 }}
          {%- if section.settings.link_label != blank -%}
            <a class="g-trust__link" href="{{ section.settings.link | default: '/pages/contact' }}">{{ section.settings.link_label }}</a>
          {%- endif -%}
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gardner product trust",
  "tag": "section",
  "class": "section-gardner-product-trust",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "header", "content": "Secure checkout" },
    { "type": "text", "id": "title_1", "label": "Title", "default": "Secure checkout" },
    {
      "type": "text",
      "id": "text_1",
      "label": "Text",
      "default": "Payment and order processing are handled by Shopify."
    },
    { "type": "header", "content": "Catalog note" },
    { "type": "text", "id": "title_2", "label": "Title", "default": "Portfolio demo" },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text",
      "default": "Demonstration prices and inventory. No real orders are fulfilled."
    },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "title_3", "label": "Title", "default": "Questions about a tool?" },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text",
      "default": "Ask before you buy."
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Contact us" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Gardner product trust" }]
}
{% endschema %}
